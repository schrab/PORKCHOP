#
# ESP32-S3 Mini custom sdkconfig
# Based on PORKCHOP sdkconfig.defaults + WiFiTool PSRAM config
#

# Core dump disabled (saves flash + boot time)
CONFIG_ESP_COREDUMP_ENABLE=n

# mbedTLS: dynamic buffers with 2KB content length (proven stable)
CONFIG_MBEDTLS_SSL_MAX_CONTENT_LEN=2048
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=2048
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_PEER_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

# WiFi buffers: tuned for packet capture (original proven values)
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP32_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP32_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# Flash: 16MB QIO at 80MHz
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# PSRAM: 8MB quad at 40MHz (ESP32-S3 Mini)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
# CONFIG_SPIRAM_MODE_OCT is not set
CONFIG_SPIRAM_TYPE_AUTO=y
# CONFIG_SPIRAM_TYPE_ESPPSRAM16 is not set
# CONFIG_SPIRAM_TYPE_ESPPSRAM32 is not set
# CONFIG_SPIRAM_TYPE_ESPPSRAM64 is not set

# PSRAM pins (ESP32-S3 Mini custom board)
# Quad PSRAM: CLK=30, CS=26, D0-D3 on SPI-related GPIOs
CONFIG_SPIRAM_CLK_IO=30
CONFIG_SPIRAM_CS_IO=26
# CONFIG_SPIRAM_XIP_FROM_PSRAM is not set
# CONFIG_SPIRAM_FETCH_INSTRUCTIONS is not set
# CONFIG_SPIRAM_RODATA is not set

# PSRAM allocation
CONFIG_SPIRAM_USE_MALLOC=y
# CONFIG_SPIRAM_USE_CAPS_ALLOC is not set
# CONFIG_SPIRAM_USE_MERGED is not set
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Thread-safe PSRAM calls
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
# WiFi/LWIP buffers in PSRAM — ESP32-S3 Mini has 8MB PSRAM,
# so WiFi RX/TX buffers can live there instead of precious internal SRAM.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
