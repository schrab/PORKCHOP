# Core dump disabled (saves flash partition + boot time)
CONFIG_ESP_COREDUMP_ENABLE=n

# mbedTLS: dynamic buffers with 2KB content length (proven stable)
CONFIG_MBEDTLS_SSL_MAX_CONTENT_LEN=2048
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=2048
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_PEER_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

# IWDT timeout: 5s for OINK mode autosave SD writes.
# 1000ms was too short — TG1WDT fired during autoSaveCheck SPI I/O
# even with promiscuous fully paused from Core 1 (cross-core handshake).
# SPI polling + WiFi driver state changes can block interrupts briefly.
# The cross-core handshake itself adds a spin-wait window.
CONFIG_ESP_INT_WDT_TIMEOUT_MS=5000

# WiFi buffers: tuned for packet capture (original proven values)
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP32_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP32_WIFI_DYNAMIC_TX_BUFFER_NUM=16
