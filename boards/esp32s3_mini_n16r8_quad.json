{
  "build": {
    "arduino":{
      "ldscript": "esp32s3_out.ld",
      "memory_type": "qio_qspi"
    },
    "core": "esp32",
    "extra_flags": [
      "-DARDUINO_ESP32S3_DEV",
      "-DARDUINO_USB_MODE=1",
      "-DARDUINO_USB_CDC_ON_BOOT=0",
      "-DBOARD_HAS_PSRAM"
    ],
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "mcu": "esp32s3",
    "variant": "esp32s3",
    "psram_mode": "enable",
    "psram_type": "psram"
  },
  "connectivity": ["wifi", "bluetooth"],
  "debug": {"openocd_target": "esp32s3.cfg"},
  "frameworks": ["arduino", "espidf"],
  "name": "ESP32-S3-Mini (16MB Flash / 8MB Quad PSRAM)",
  "upload": {
    "flash_size": "16MB",
    "maximum_ram_size": 8388608,
    "maximum_size": 16777216,
    "require_upload_port": true,
    "speed": 921600
  },
  "url": "",
  "vendor": "Espressif"
}
